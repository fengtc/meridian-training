# NVIDIA DGX Spark GB10: one visible GPU, vendor PyTorch/ARM64 environment.
export MERIDIAN_DEVICE_PROFILE=dgx-spark-gb10
export MERIDIAN_GPUS=1
export MERIDIAN_GRADIENT_ACCUMULATION=8
export MERIDIAN_DATA_ROOT="${MERIDIAN_DATA_ROOT:-$HOME/meridian-data}"
export VENV_ROOT="${VENV_ROOT:-$PROJECT_ROOT/.venv}"
