# One host with two RTX 5090 GPUs: x86_64, BF16, CUDA/NCCL.
export MERIDIAN_DEVICE_PROFILE=rtx5090-2
export MERIDIAN_GPUS=2
export MERIDIAN_GRADIENT_ACCUMULATION=8
export MERIDIAN_DATA_ROOT="${MERIDIAN_DATA_ROOT:-/mnt/meridian-data}"
export VENV_ROOT="${VENV_ROOT:-/mnt/meridian-data/venvs/meridian-5090}"
