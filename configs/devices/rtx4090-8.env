# One host with eight RTX 4090 GPUs: x86_64, BF16, CUDA/NCCL.
# 24 GiB cards require activation recomputation for the 500M model at seq=2048.
export MERIDIAN_DEVICE_PROFILE=rtx4090-8
export MERIDIAN_GPUS=8
export MERIDIAN_GRADIENT_ACCUMULATION=8
export MERIDIAN_DATA_ROOT="${MERIDIAN_DATA_ROOT:-$HOME/meridian-data}"
export VENV_ROOT="${VENV_ROOT:-$HOME/meridian-data/venvs/meridian-4090}"
export MERIDIAN_RECOMPUTE_GRANULARITY="${MERIDIAN_RECOMPUTE_GRANULARITY:-full}"
export MERIDIAN_RECOMPUTE_METHOD="${MERIDIAN_RECOMPUTE_METHOD:-uniform}"
export MERIDIAN_RECOMPUTE_NUM_LAYERS="${MERIDIAN_RECOMPUTE_NUM_LAYERS:-1}"
